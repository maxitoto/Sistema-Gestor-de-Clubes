{
  "name": "Backend-Gestor-De-Clubes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run start",
    "start": "bun run start:containers && bun run start:functions",
    "start:functions": "bun run scripts/servir-funciones-local.ts",
    "start:containers": "bunx supabase start --workdir ..",
    "correos:local": "bun --env-file=functions/.env scripts/procesar-correos-local.ts",
    "correos:una-vez": "bun --env-file=functions/.env scripts/procesar-correos-local.ts --once",
    "stop": "bunx supabase stop --workdir ..",
    "db:reset": "bunx supabase db reset --workdir ..",
    "db:push": "bunx supabase db push --workdir ..",
    "db:pull": "bunx supabase db pull --workdir ..",
    "db:finalizar": "bun scripts/finalizar-migracion.mjs",
    "newEdge": "bunx supabase functions new --workdir ..",
    "lint:arch": "bunx --bun depcruise functions",
    "lint:functions": "bunx --bun deno lint functions/",
    "typecheck:functions": "bunx --bun deno check --config functions/deno.json functions/comunicaciones/index.ts functions/monitoreo/index.ts functions/arca/index.ts",
    "format:functions": "bunx --bun deno fmt functions/",
    "lint:functionsfix": "bun run format:functions",
    "lint:fix": "bun run format:functions && bun run lint",
    "lint": "bun run lint:functions && bun run lint:arch"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "deno-bin": "2.2.7",
    "dependency-cruiser": "18.3.1",
    "typescript": "6"
  }
}
