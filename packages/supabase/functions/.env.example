# Copiar a functions/.env local y NO versionarlo. Nunca copiar estos secretos al frontend.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los provee Supabase.
MAIL_PROVIDER=mailpit
MAIL_FROM="Club Los Andes <notificaciones@clublosandes.com>"
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
MAIL_PUBLIC_BASE_URL=http://127.0.0.1:54321/functions/v1/comunicaciones
# Completar con dos secretos aleatorios distintos de al menos 32 caracteres.
MAIL_UNSUBSCRIBE_SECRET=
MAIL_WORKER_SECRET=
# No se necesitan para Mailpit. En producción se configura Resend por separado.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=